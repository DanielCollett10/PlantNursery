<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the headless Sim tests. Clearing first means a broken
  machine-wide NuGet setting (e.g. a missing Visual Studio offline folder)
  can't break agent test runs.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
